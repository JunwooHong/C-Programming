        public static EmployeeData readData(EmployeeData data)
        {

            for (int i = 0; i < data.salary.Length; i++)

            {
                Console.Write("Enter the salary, month and Name for employee number {0}: ", i + 1);

                string input = Console.ReadLine();

                data.salary[i] = Convert.ToInt16(input.Split(" ")[0]);

                data.month[i] = Convert.ToInt16(input.Split(" ")[1]);

                data.names[i] = input.Split(" ")[2] + " " + input.Split(" ")[3];

            }

            return data;

        }

        public static void maxSalary(EmployeeData data)

        {

            int maxIndex = 0;

            for (int i = 0; i < data.salary.Length; i++)

            {

                if (data.salary[i] > data.salary[maxIndex])

                    maxIndex = i;

            }

            Console.WriteLine($"The name of the employee with the highest salary is {data.names[maxIndex]}");

        }

